<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_quick_bill" model="ir.ui.view">
        <field name="name">purchase.order.form.quick.bill</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_quick_generate_bill"
                        type="object"
                        string="Generate Bill (Received Qty)"
                        class="btn-secondary"
                        invisible="state not in ('purchase', 'done') or invoice_status == 'invoiced'"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
