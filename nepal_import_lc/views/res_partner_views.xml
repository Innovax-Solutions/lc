<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_import_settings_tab" model="ir.ui.view">
        <field name="name">res.partner.import.settings</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Import Settings" name="import_settings"
                      invisible="supplier_rank == 0">
                    <group string="Mandatory Import Transaction Type">
                        <field name="is_lc_mandatory"/>
                        <field name="is_pc_mandatory"/>
                        <field name="is_pp_mandatory"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
