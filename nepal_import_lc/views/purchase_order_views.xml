<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_import_fields" model="ir.ui.view">
        <field name="name">purchase.order.import.fields</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="import_transaction_type"/>
                <field name="lc_id"
                       invisible="import_transaction_type != 'lc'"
                       required="import_transaction_type == 'lc'"/>
            </field>
        </field>
    </record>
</odoo>
