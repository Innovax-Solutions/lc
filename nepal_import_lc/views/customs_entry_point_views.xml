<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nepal_customs_entry_point_list" model="ir.ui.view">
        <field name="name">nepal.customs.entry.point.list</field>
        <field name="model">nepal.customs.entry.point</field>
        <field name="arch" type="xml">
            <list string="Customs Entry Points" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="border_type"/>
                <field name="nrb_approved"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_nepal_customs_entry_point_form" model="ir.ui.view">
        <field name="name">nepal.customs.entry.point.form</field>
        <field name="model">nepal.customs.entry.point</field>
        <field name="arch" type="xml">
            <form string="Customs Entry Point">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="border_type"/>
                        <field name="nrb_approved"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nepal_customs_entry_point" model="ir.actions.act_window">
        <field name="name">Customs Entry Points</field>
        <field name="res_model">nepal.customs.entry.point</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
