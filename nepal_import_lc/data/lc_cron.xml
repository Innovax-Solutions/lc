<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_lc_auto_expire" model="ir.cron">
        <field name="name">LC: Auto-expire overdue LCs</field>
        <field name="model_id" ref="model_nepal_lc_master"/>
        <field name="state">code</field>
        <field name="code">model.action_expire_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>
</odoo>
